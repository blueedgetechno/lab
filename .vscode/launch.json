{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch local server",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/common/serve.cjs",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "outputCapture": "std",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "envFile": "${workspaceFolder}/.env.local",
      "env": {
        "PORT": "3000"
      },
      "serverReadyAction": {
        "pattern": "Blue Edge Lab: (http://127\\.0\\.0\\.1:[0-9]+/)",
        "uriFormat": "%s",
        "action": "debugWithChrome",
        "webRoot": "${workspaceFolder}"
      }
    }
  ]
}
